{% trans_default_domain 'YokaiBatchBundle' %}

{# @var execution \Yokai\Batch\JobExecution #}
{% set classMap = {
    'Pending': 'light',
    'Running': 'warning',
    'Stopped': 'info',
    'Completed': 'success',
    'Abandoned': 'info',
    'Failed': 'danger',
} %}
<span class="badge badge-{{ classMap[execution.status.name] }}">
    {{ ('job.status.'~execution.status.name|lower)|trans }}
</span>
