{% extends base_template %}

{% trans_default_domain 'YokaiBatchBundle' %}

{# @var execution \Yokai\Batch\JobExecution #}

{% set parameters = app.request.query.all('filter') %}

{% block title %}
    - {{ 'job.name'|trans }}
{% endblock %}

{% block navbar_title %}
{% endblock %}

{%- block actions -%}
{%- endblock -%}

{%- block tab_menu -%}
{%- endblock -%}

{% block breadcrumb %}
    <ol class="nav navbar-top-links breadcrumb">
        <li>
            <a href="{{ path('sonata_admin_dashboard') }}">
                <i class="fa fa-home"></i>
            </a>
        </li>
        <li class="active">
            <span>
                {{ 'job.name'|trans }}
            </span>
        </li>
    </ol>
{% endblock %}

{% block list_table %}
    <div class="col-xs-12 col-md-12">
        <div class="box box-primary"{% if pagination.is.last %} style="margin-bottom: 100px;"{% endif %}>
            <div class="box-body{% if executions|length > 0 %} table-responsive no-padding{% endif %}">
                <table class="table table-bordered table-striped table-hover sonata-ba-list">
                    <thead>
                    <tr class="sonata-ba-list-filter-header">
                        <th class="sonata-ba-list-filter-header-text">
                            {{ 'job.field.execution_id'|trans }}
                        </th>
                        <th class="sonata-ba-list-filter-header-text">
                            {{ 'job.field.job_name'|trans }}
                        </th>
                        <th class="sonata-ba-list-filter-header-text">
                            {{ 'job.field.status'|trans }}
                        </th>
                        <th class="sonata-ba-list-filter-header-datetime {% if sort.start.sorted %}sonata-ba-list-field-order-active sonata-ba-list-field-header-order-{{ sort.desc ? 'desc' : 'asc' }}{% endif %}">
                            <a href="{{ path('yokai_batch.job_list', { filter: parameters, (sort.parameter): sort.start.switch }) }}">
                                {{ 'job.field.start_time'|trans }}
                            </a>
                        </th>
                        <th class="sonata-ba-list-filter-header-datetime {% if sort.end.sorted %}sonata-ba-list-field-order-active sonata-ba-list-field-header-order-{{ sort.desc ? 'desc' : 'asc' }}{% endif %}">
                            <a href="{{ path('yokai_batch.job_list', { filter: parameters, (sort.parameter): sort.end.switch }) }}">
                                {{ 'job.field.end_time'|trans }}
                            </a>
                        </th>
                        <th class="sonata-ba-list-filter-header-actions"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for execution in executions %}
                        <tr>
                            <td class="sonata-ba-list-field sonata-ba-list-field-text">
                                {% if yokai_batch_grant_view(execution) %}
                                    <a class="sonata-link-identifier" href="{{ path('yokai_batch.job_view', { job: execution.jobName, id: execution.id }) }}">
                                        {{ execution.id }}
                                    </a>
                                {% else %}
                                    {{ execution.id }}
                                {% endif %}
                            </td>
                            <td class="sonata-ba-list-field sonata-ba-list-field-text">
                                {% include '@YokaiBatch/sonata/_job-name.html.twig' with { execution: execution } only %}
                            </td>
                            <td class="sonata-ba-list-field sonata-ba-list-field-text">
                                {% include '@YokaiBatch/sonata/_status.html.twig' with { execution: execution } only %}
                            </td>
                            <td class="sonata-ba-list-field sonata-ba-list-field-datetime">
                                {%- include '@SonataAdmin/CRUD/display_datetime.html.twig' with { value: execution.startTime } only -%}
                            </td>
                            <td class="sonata-ba-list-field sonata-ba-list-field-datetime">
                                {%- include '@SonataAdmin/CRUD/display_datetime.html.twig' with { value: execution.endTime } only -%}
                            </td>
                            <td class="sonata-ba-list-field sonata-ba-list-field-actions">
                                <div class="btn-group">
                                    {% if yokai_batch_grant_view(execution) %}
                                        <a
                                            href="{{ path('yokai_batch.job_view', { job: execution.jobName, id: execution.id }) }}"
                                            class="btn btn-sm btn-default view_link"
                                            title="{{ 'action_show'|trans({}, 'SonataAdminBundle') }}"
                                        >
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            {{ 'action_show'|trans({}, 'SonataAdminBundle') }}
                                        </a>
                                    {% endif %}
                                    {% if yokai_batch_grant_logs(execution) %}
                                        <a
                                            href="{{ path('yokai_batch.job_logs', { job: execution.jobName, id: execution.id }) }}"
                                            class="btn btn-sm btn-default"
                                            title="{{ 'job.action.download_logs'|trans }}"
                                        >
                                            <i class="fa fa-download" aria-hidden="true"></i> {{ 'job.action.download_logs'|trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if pagination.total_pages > 1 %}
            <div class="box-footer">
                <div class="text-center">
                    {% set window_start = max(1, pagination.current - pagination.page_range) %}
                    {% set window_end = min(pagination.total_pages, pagination.current + pagination.page_range) %}
                    <ul class="pagination">
                        {% if pagination.prev.enabled %}
                            <li>
                                <a href="{{ path('yokai_batch.job_list', { filter: parameters, (pagination.parameter): pagination.prev.value, (sort.parameter): sort.current }) }}"
                                   title="{{ 'link_previous_pager'|trans({}, 'SonataAdminBundle') }}">&lsaquo;</a>
                            </li>
                        {% endif %}

                        {% if window_start > 1 %}
                            <li><a href="{{ path('yokai_batch.job_list', { filter: parameters, (pagination.parameter): 1, (sort.parameter): sort.current }) }}">1</a></li>
                            {% if window_start > 2 %}<li class="disabled"><span>…</span></li>{% endif %}
                        {% endif %}

                        {% for p in range(window_start, window_end) %}
                            <li class="{% if p == pagination.current %}active{% endif %}">
                                <a href="{{ path('yokai_batch.job_list', { filter: parameters, (pagination.parameter): p, (sort.parameter): sort.current }) }}">{{ p }}</a>
                            </li>
                        {% endfor %}

                        {% if window_end < pagination.total_pages %}
                            {% if window_end < pagination.total_pages - 1 %}<li class="disabled"><span>…</span></li>{% endif %}
                            <li><a href="{{ path('yokai_batch.job_list', { filter: parameters, (pagination.parameter): pagination.total_pages, (sort.parameter): sort.current }) }}">{{ pagination.total_pages }}</a></li>
                        {% endif %}

                        {% if pagination.next.enabled %}
                            <li>
                                <a href="{{ path('yokai_batch.job_list', { filter: parameters, (pagination.parameter): pagination.next.value, (sort.parameter): sort.current }) }}"
                                   title="{{ 'link_next_pager'|trans({}, 'SonataAdminBundle') }}">&rsaquo;</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block list_filters_actions %}
    <ul class="nav navbar-nav navbar-right" id="filter-list-job-execution" {{ stimulus_controller('sonata-filter-list', {}, { 'active': 'active' }, { 'sonata-filter': '#filter-container-job-execution' }) }}>
        <li class="dropdown sonata-actions">
            <a href="#" class="dropdown-toggle sonata-ba-action" data-toggle="dropdown">
                <i class="fas fa-filter" aria-hidden="true"></i>
                {{ 'link_filters'|trans({}, 'SonataAdminBundle') }}
                <span class="badge" {{ stimulus_target('sonata-filter-list', 'counter') }}></span>
                <b class="caret"></b>
            </a>

            <ul class="dropdown-menu dropdown-menu-scrollable" role="menu">
                {% for filter in form %}
                    {% set filterDisplayed = filter.vars.name in filters %}
                    <li class="sonata-filter-option">
                        <a href="#" class="sonata-toggle-filter sonata-ba-action{% if filterDisplayed %} active{% endif %}" data-filter="filter-job-execution-{{ filter.vars.name }}" {{ stimulus_target('sonata-filter-list', 'field') }} {{ stimulus_action('sonata-filter-list', 'toggle:prevent:stop', 'click') }}>
                            <i class="far"></i>
                            {{ (filter.vars.label)|trans({}, filter.vars.translation_domain) }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </li>
    </ul>
{% endblock %}

{% block list_filters %}
    {% form_theme form filter_template %}
    <div class="col-xs-12 col-md-12 sonata-filters-box"
         id="filter-container-job-execution" {{ stimulus_controller('sonata-filter', {}, {}, { 'sonata-filter-list': '#filter-list-job-execution' }) }} {% if not filters|length %}hidden{% endif %}>
        <div class="box box-primary" >
            <div class="box-body">
                <form
                    class="sonata-filter-form form-horizontal"
                    action="{{ path('yokai_batch.job_list') }}"
                    method="GET"
                    role="form"
                    {{ stimulus_target('sonata-filter', 'form') }}
                    {{ stimulus_action('sonata-filter', 'prepareSubmit', 'submit') }}>
                    {{ form_errors(form) }}

                    <div class="row">
                        <div class="col-sm-9">
                            {% for filter in form %}
                                {% set filterDisplayed = filter.vars.name in filters %}
                                <div class="form-group" id="filter-job-execution-{{ filter.vars.name }}" {{ stimulus_target('sonata-filter', 'group') }} {% if not filterDisplayed %}hidden{% endif %}>
                                    <label for="{{ filter.vars.id }}" class="col-sm-3 control-label">{{ filter.vars.label|trans({}, filter.vars.translation_domain) }}</label>
                                    <div class="col-sm-4 advanced-filter" hidden>
                                    </div>
                                    <div class="col-sm-4">
                                        {{ form_widget(filter) }}
                                    </div>
                                    <div class="col-sm-1">
                                        <label class="control-label">
                                            <a href="#" class="sonata-ba-action" {{ stimulus_action('sonata-filter', 'hideFilter', 'click', { 'id': 'filter-job-execution-' ~ filter.vars.name }) }}>
                                                <i class="fas fa-minus-circle" aria-hidden="true"></i>
                                            </a>
                                        </label>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="col-sm-3 text-center">
                            {{ form_rest(form) }}

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary" {{ stimulus_target('sonata-filter', 'submitter') }}>
                                    <i class="fas fa-filter" aria-hidden="true"></i> {{ 'btn_filter'|trans({}, 'SonataAdminBundle') }}
                                </button>

                                <a class="btn btn-default" href="{{ path('yokai_batch.job_list') }}">
                                    {{ 'link_reset_filter'|trans({}, 'SonataAdminBundle') }}
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
