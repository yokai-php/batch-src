{
    "name": "yokai/batch-symfony-uid",
    "description": "symfony/uid bridge for yokai/batch",
    "keywords": ["batch", "job", "execution", "uuid"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yann Eugoné",
            "email": "eugone.yann@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/uid": "^6.4|^7.0",
        "yokai/batch": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "Yokai\\Batch\\Bridge\\Symfony\\Uid\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Yokai\\Batch\\Tests\\Bridge\\Symfony\\Uid\\": "tests/"
        }
    }
}
